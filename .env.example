# GhostMail One-Click Deploy Configuration
# Copy to .env and edit before running: docker compose up

# Server hostname (used in email headers and DKIM)
GHOSTMAIL_HOSTNAME=mail.example.com

# Primary email domain
GHOSTMAIL_DOMAIN=example.com

# Initial admin account (created on first boot)
GHOSTMAIL_ADMIN_USER=admin
GHOSTMAIL_ADMIN_PASSWORD=changeme-please

# Data directory inside container (mapped to volume)
GHOSTMAIL_DATA_DIR=/var/lib/ghostmail

# Logging level: error, warn, info, debug
GHOSTMAIL_LOG_LEVEL=info

# Admin/webmail panel port inside container
GHOSTMAIL_ADMIN_ADDR=:8080

# Caddy TLS domain (set for Let's Encrypt, leave empty for self-signed)
# For production: set to your actual domain and ensure port 443 is accessible
CADDY_DOMAIN=
